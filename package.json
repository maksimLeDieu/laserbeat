{
  "name": "laserbeat",
  "productName": "LaserBeat",
  "version": "2.7.0",
  "description": "Musique ML - lecteur de musique hors ligne pour le laser game",
  "author": "Maxime Loret",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never",
    "test": "node tests/run.js"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "fr.laserbeat.app",
    "productName": "LaserBeat",
    "copyright": "© Maxime Loret",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "musiques",
        "to": "musiques",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "LaserBeat",
      "legalTrademarks": "Musique ML"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Musique ML",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Musique ML",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "multiLanguageInstaller": true,
      "include": "build/installer.nsh",
      "artifactName": "LaserBeat-Setup.${ext}",
      "displayLanguageSelector": false
    },
    "publish": {
      "provider": "github",
      "owner": "maksimLeDieu",
      "repo": "laserbeat",
      "releaseType": "release"
    },
    "extraFiles": [
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
